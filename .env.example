# ImageKit URL endpoint — found in the ImageKit dashboard under URL Endpoints.
# Used to resolve relative image/video paths stored in src/data/*.json.
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Base URL of the oling-dawn-kerjew-backend API (used by the dashboard's Gallery/
# Media Library feature).
VITE_API_URL=http://localhost:5002
